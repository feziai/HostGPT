# Never commit your real .env. Copy to .env, then set NEW rotated credentials.
ADMIN_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_PASSWORD
HOST=127.0.0.1
PORT=3000
# Public HTTPS deployments: put behind TLS reverse proxy and set COOKIE_SECURE=1
COOKIE_SECURE=0
# AI: free local Ollama endpoint. Requires running Ollama on the same host.
OLLAMA_LOCAL_URL=http://127.0.0.1:11434
OLLAMA_LOCAL_MODEL=qwen2.5-coder:7b
# Optional paid / rate-limited provider APIs
OLLAMA_CLOUD_API_KEY=
OLLAMA_CLOUD_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
XAI_API_KEY=
XAI_MODEL=grok-4.7
# Optional GitHub token with minimum permissions to repositories that you choose
GITHUB_TOKEN=
# Optional MongoDB Atlas connection; install MongoDB driver via npm install
MONGODB_URI=
# Optional independent access token for read-only MCP endpoint
MCP_ACCESS_TOKEN=

# Optional providers (API calls are server-side only)
HF_TOKEN=
HF_MODEL=Qwen/Qwen2.5-Coder-7B-Instruct
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3-coder:free
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
